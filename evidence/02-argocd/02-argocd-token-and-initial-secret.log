echo "$RESP" | jq '{token:.token}' | aws secretsmanager create-secret --name arc/argocd-token \
  --description "Argo CD read-only token for arc-intel ([REDACTED_CLUSTER_NAME])" --secret-string file:///dev/stdin

kill $PF; unset PW SESSION RESP
