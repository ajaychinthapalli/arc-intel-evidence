bash-5.3$ test_app() {
  local J APP INST KEY H P S b64
  J=$(aws secretsmanager get-secret-value --secret-id "$1" --query SecretString --output text)
  APP=$(jq -r .github_app_id <<<"$J"); INST=$(jq -r .github_app_installation_id <<<"$J")
  KEY=$(mktemp); chmod 600 "$KEY"; jq -r .github_app_private_key <<<"$J" > "$KEY"
  b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
  H=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
  P=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $(( $(date +%s) - 60 )) $(( $(date +%s) + 540 )) "$APP" | b64)
  S=$(printf '%s.%s' "$H" "$P" | openssl dgst -sha256 -sign "$KEY" | b64); rm -f "$KEY"
  echo "== $1 (app $APP, configured installation $INST)"
  curl -s -H "Authorization: Bearer $H.$P.$S" -H "Accept: application/vnd.github+json" https://api.github.com/app \
    | jq -r '"   app: \(.slug // ("error: " + .message))"'
  curl -s -H "Authorization: Bearer $H.$P.$S" -H "Accept: application/vnd.github+json" https://api.github.com/app/installations \
    | jq -r 'if type=="array" then (if length==0 then "   no installations" else .[] | "   installation \(.id) on \(.account.login) (\(.repository_selection))" end) else "   error: \(.message)" end'
}
test_app arc/[REDACTED_CLUSTER_NAME]/github-app
