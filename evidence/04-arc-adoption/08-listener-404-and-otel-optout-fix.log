bash-5.3$ K=clusters/[REDACTED_CLUSTER_NAME]/manifests/arc-intel/kustomization.yaml
cat >> "$K" <<'EOF'
  # CloudWatch Application Signals: never inject auto-instrumentation into arc-intel (Python; the
  # injected init container also violates the namespace's restricted Pod Security standard).
  - target: {kind: Deployment, name: arc-intel-mcp}
    patch: |-
      - op: add
        path: /spec/template/metadata/annotations
        value:
          instrumentation.opentelemetry.io/inject-java: "false"
          instrumentation.opentelemetry.io/inject-python: "false"
          instrumentation.opentelemetry.io/inject-nodejs: "false"
          instrumentation.opentelemetry.io/inject-dotnet: "false"
EOF
tail -14 "$K"
git add "$K" && git commit -m "arc-intel: opt out of CloudWatch auto-instrumentation" && git push
argocd app get arc-intel --hard-refresh >/dev/null && argocd app sync arc-intel
kubectl -n arc-intel rollout status deploy/arc-intel-mcp --timeout=120s
