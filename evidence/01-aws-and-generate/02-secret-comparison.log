bash-5.3$ SM=$(aws secretsmanager get-secret-value --secret-id [REDACTED_SECRET_NAME] --query SecretString --output text)
K8S=$(kubectl -n arc-runners get secret arc-github-app -o json | jq '.data | map_values(@base64d)')
for k in $(jq -rn --argjson a "$SM" --argjson b "$K8S" '($a|keys) + ($b|keys) | unique[]'); do
  a=$(jq -rn --argjson o "$SM"  --arg k "$k" '$o[$k] // "MISSING"' | sed -e 's/[[:space:]]*$//')
  b=$(jq -rn --argjson o "$K8S" --arg k "$k" '$o[$k] // "MISSING"' | sed -e 's/[[:space:]]*$//')
  [ "$a" = "$b" ] && echo "match    $k" || echo "DIFFERS  $k"
done
DIFFERS  github_app_id
DIFFERS  github_app_installation_id
DIFFERS  github_app_private_key
