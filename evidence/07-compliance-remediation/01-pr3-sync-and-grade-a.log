bash-5.3$ VER=$(gh api repos/actions/runner/releases/latest --jq .tag_name | sed 's/^v//'); echo "runner $VER"
git switch -c fix/arc-runner-set-compliance
cat > clusters/[REDACTED_CLUSTER_NAME]/runner-scale-sets/arc-runner-set/values.yaml <<EOF
# Values of Helm release 'arc-runner-set', managed by Argo CD.
# Change runner pools through PRs to this file; Argo CD applies them.
githubConfigSecret: arc-github-app
githubConfigUrl: https://github.com/ajaychinthapalli/arc-runners-sandbox
maxRunners: 3
minRunners: 0
# ARC-013: ownership labels for chargeback and incident routing
labels:
  owner: ajaychinthapalli
  cost-center: sandbox
template:
  metadata:
    annotations:
      karpenter.sh/do-not-disrupt: "true"
  spec:
    containers:
      - name: runner
        image: ghcr.io/actions/actions-runner:${VER}   # ARC-005: pinned (add @sha256:<digest> for immutability)
        command:
          - /home/runner/run.sh
        resources:
          requests:
            cpu: 500m
            memory: 1Gi
          limits:
            cpu: "1"          # ARC-010
            memory: 2Gi
        securityContext:
          allowPrivilegeEscalation: false   # ARC-011
    nodeSelector:
      capacity: ondemand
      workload: ci-runner
    terminationGracePeriodSeconds: 60
    tolerations:
      - effect: NoSchedule
        key: workload
        value: ci-runner
# Explicit because Argo CD renders without cluster access (the chart's controller lookup returns nothing).
controllerServiceAccount:
  namespace: arc-systems
  name: arc-gha-rs-controller
EOF
git diff --stat
git add -A && git commit -m "arc-runner-set: pin runner image, CPU limit, no privilege escalation, ownership labels"
git push -u origin fix/arc-runner-set-compliance
gh pr create --base main --title "arc-runner-set: fix ARC-005/010/011/013" \
  --body "Pins the runner image to ${VER}, adds a CPU limit, sets allowPrivilegeEscalation=false and adds owner/cost-center labels. Expected result: arc-intel score 78 -> 100."
